DONNE "TABLE [JE VOUS MON VOTRE MA VOTRE MES VOS MOI VOUS VOUS MOI VOTRE MON VOS MES SUIS ETES ETES SUIS AI AVEZ]
DONNE "TABLE PHRASE :TABLE [AVEZ AI VEUX VOULEZ VOULEZ VEUX PEUX POUVEZ POUVEZ PEUX SENS SENTEZ SENTEZ SENS]
DONNE "TABLE PHRASE :TABLE [AIME AIMEZ AIMEZ AIME PENSE PENSEZ PENSEZ PENSE ETAIS ETIEZ ETIEZ ETAIS DOIS DEVEZ]
DONNE "TABLE PHRASE :TABLE [DEVEZ DOIS FAIS FAITES FAITES FAIS VAIS ALLEZ ALLEZ VAIS SAIS SAVEZ SAVEZ SAIS TU JE]
DONNE "TABLE PHRASE :TABLE [TON MON TA MA TES MES TOI MOI J'AI [VOUS AVEZ] J'ETAIS [VOUS ETIEZ] VOTRE MON]
DONNE "FALLBACK [[PARLEZ-MOI DE VOUS] [CONTINUEZ]]
DONNE "FALLBACK PHRASE :FALLBACK [[ET ALORS] [JE VOUS ECOUTE]]
DONNE "FALLBACK PHRASE :FALLBACK [[VOUS POUVEZ ALLER PLUS LOIN] [C EST INTERESSANT]]
DONNE "FALLBACK PHRASE :FALLBACK [[RACONTEZ-MOI ENCORE] [ET APRES]]
POUR APRES :L :M
DONNE "CUR :L
DONNE "FOUND 0
REPETE 60 [ETAPEA :M]
RENDS :CUR
FIN
POUR ETAPEA :M
SI :FOUND = 1 [STOP]
SI VIDE? :CUR [STOP]
SI :M = (PREMIER :CUR) [DONNE "FOUND 1 DONNE "CUR (SP :CUR)] [DONNE "CUR (SP :CUR)]
FIN
POUR REMPL :M
DONNE "CUR :TABLE
DONNE "RES :M
DONNE "FOUND 0
REPETE 80 [ETAPEM :M]
RENDS :RES
FIN
POUR ETAPEM :M
SI :FOUND = 1 [STOP]
SI VIDE? :CUR [STOP]
SI :M = (PREMIER :CUR) [DONNE "RES (ITEM 2 :CUR) DONNE "FOUND 1] [DONNE "CUR (SP (SP :CUR))]
FIN
POUR REFLETE :L
DONNE "IN :L
DONNE "OUT []
REPETE 60 [PASSE]
RENDS :OUT
FIN
POUR PASSE
SI VIDE? :IN [STOP]
DONNE "OUT PHRASE :OUT (REMPL (PREMIER :IN))
DONNE "IN (SP :IN)
FIN
POUR RAPPEL :E :K :T
ECRIS PHRASE :T (REFLETE (APRES :E :K))
FIN
POUR REPONDS :E
SI (MEMBRE? "AUREVOIR :E) [ECRIS [AU REVOIR. BONNE CHANCE AVEC VOTRE LOCI.] QUITTE]
SI (VIDE? :E) [ECRIS [LE SILENCE EST UNE REPONSE COMME UNE AUTRE.] STOP]
SI (MEMBRE? "ORIC :E) [ECRIS [L ORIC, 64 KO ET UN BEEP. JE LE CONNAIS BIEN.] STOP]
SI (MEMBRE? "CPA :E) [ECRIS [CPA, MON CREATEUR M A RESERVE 1,3 KO DE LIBRE.] STOP]
SI (MEMBRE? "LOGO :E) [ECRIS [LA TORTUE TOURNE A GAUCHE, COMME MES IDEES.] STOP]
SI (MEMBRE? "BUG :E) [ECRIS [UN BUG, C EST UNE FONCTION NON DOCUMENTEE.] STOP]
SI (MEMBRE? "BASIC :E) [ECRIS [LE BASIC, C EST LE PASSE. CPA EST LE FUTUR.] STOP]
SI (MEMBRE? "ASM :E) [ECRIS [L ASSEMBLEUR, C EST DU 6502 SANS FILET. COURAGE.] STOP]
SI (MEMBRE? "DISQUETTE :E) [ECRIS [UNE DISQUETTE, C EST 170 SECTEURS DE CONFIANCE.] STOP]
SI (MEMBRE? "MEMOIRE :E) [ECRIS [LA MEMOIRE EST LIMITEE. LES SOUVENIRS AUSSI.] STOP]
SI (MEMBRE? "LOCI :E) [ECRIS [LE LOCI A UNE CLE USB. C EST UN PEU NOTRE EPOQUE.] STOP]
SI (MEMBRE? "TORTUE :E) [ECRIS [LA TORTUE AVANCE LENTEMENT, COMME VOTRE PROJET.] STOP]
SI (MEMBRE? "CODE :E) [ECRIS [LE CODE, C EST DE LA POESIE QUI NE MARCHE PAS ENCORE.] STOP]
SI (MEMBRE? "JEU :E) [ECRIS [UN JEU, JE PREFERE LES PARTIES ENTRE NOUS.] STOP]
SI (MEMBRE? "FATIGUE :E) [ECRIS [LA TORTUE NE DORT JAMAIS, ELLE. VOUS, FAITES UNE PAUSE.] STOP]
SI (MEMBRE? "TRISTE :E) [ECRIS [UN PETIT PROGRAMME PEUT PARFOIS REMONTER LE MORAL.] STOP]
SI (MEMBRE? "PEUR :E) [ECRIS [LA PEUR, C EST LE DEBUT DE LA PROGRAMMATION.] STOP]
SI (MEMBRE? "SEUL :E) [ECRIS [VOUS ETES SEUL DEVANT VOTRE ORIC. C EST LE PROPRE DU HACKER.] STOP]
SI (MEMBRE? "HEUREUX :E) [ECRIS [TANT MIEUX. ON CODE BIEN QU EN ETANT CONTENT.] STOP]
SI (MEMBRE? "OUI :E) [ECRIS [OUI, C EST UNE REPONSE. ON Y VA.] STOP]
SI (MEMBRE? "NON :E) [ECRIS [NON, C EST UNE REPONSE AUSSI. NOTEZ-LA.] STOP]
SI (MEMBRE? "PERSONNE :E) [ECRIS [PERSONNE, VRAIMENT. LE LOCI, LUI, COMPTE POUR DU BEURRE.] STOP]
SI (MEMBRE? "TOUJOURS :E) [ECRIS [TOUJOURS, C EST UN MOT FORT. IL MERITE UNE LIGNE DE PLUS.] STOP]
SI (MEMBRE? "SUIS :E) [RAPPEL :E "SUIS [DEPUIS QUAND ETES-VOUS] STOP]
SI (MEMBRE? "AIME :E) [RAPPEL :E "AIME [POURQUOI AIMEZ-VOUS] STOP]
SI (MEMBRE? "SENS :E) [RAPPEL :E "SENS [POURQUOI VOUS SENTEZ-VOUS] STOP]
SI (MEMBRE? "VEUX :E) [RAPPEL :E "VEUX [POURQUOI VOULEZ-VOUS] STOP]
SI (MEMBRE? "PEUX :E) [RAPPEL :E "PEUX [QU EST-CE QUI VOUS EMPECHE DE] STOP]
SI (MEMBRE? "DOIS :E) [RAPPEL :E "DOIS [POURQUOI DEVEZ-VOUS] STOP]
SI (MEMBRE? "PENSE :E) [RAPPEL :E "PENSE [POURQUOI PENSEZ-VOUS QUE] STOP]
SI (MEMBRE? "SAIS :E) [RAPPEL :E "SAIS [DEPUIS QUAND SAVEZ-VOUS] STOP]
SI (MEMBRE? "ETAIS :E) [RAPPEL :E "ETAIS [DEPUIS QUAND ETIEZ-VOUS] STOP]
SI (MEMBRE? "FAIS :E) [RAPPEL :E "FAIS [POURQUOI FAITES-VOUS] STOP]
SI (MEMBRE? "VAIS :E) [RAPPEL :E "VAIS [OU ALLEZ-VOUS] STOP]
SI (MEMBRE? "J'AI :E) [RAPPEL :E "J'AI [DEPUIS QUAND AVEZ-VOUS] STOP]
SI (MEMBRE? "AI :E) [RAPPEL :E "AI [DEPUIS QUAND AVEZ-VOUS] STOP]
SI (MEMBRE? "JE :E) [RAPPEL :E "JE [VOUS DITES QUE] STOP]
SI (MEMBRE? "MOI :E) [RAPPEL :E "MOI [VOUS PARLEZ DE] STOP]
SI (MEMBRE? "MON :E) [RAPPEL :E "MON [PARLEZ-MOI DE VOTRE] STOP]
ECRIS ITEM (1 + HASARD 8) :FALLBACK
FIN
POUR TOUR
ECRIS "VOUS
DONNE "E LISLISTE
REPONDS :E
FIN
POUR DOCTEUR
ECRIS [BONJOUR. JE SUIS DOCTEUR, PSYCHOLOGUE SUR ORIC.]
ECRIS [PAS BESOIN DE PONCTUATION, JE LIS LES MOTS.]
ECRIS [POUR SORTIR, TAPEZ AUREVOIR.]
REPETE 9999 [TOUR]
FIN
DOCTEUR
