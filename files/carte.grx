; CARTE.GRX : une ile de 64 x 32 tuiles de 2 x 2 (T$), vue par une
; fenetre de 38 x 26 (TMAP) centree sur le joueur ; fleches, Q : fin
; Tuiles dessinees dans le jeu secondaire (TUILES.SPR, TFONT) ; la
; carte s'ecrit en clair : ~ eau, espace herbe, # mur, ^ arbre,
; M montagne. Hors de la carte : la tuile 0, l'eau.
; INKEY : pas d'attente ; l'ecran n'est redessine (CALC) qu'apres un pas
DIM T$(32,64) D$(5,4) S$(152)
BLOAD S$ TUILES.SPR
ECHO Construction du monde...
FOR J 0 3
  D$(0,J) = 34                 ; eau
  D$(1,J) = 33                 ; herbe (vide)
  D$(2,J) = 35                 ; mur
  D$(3,J) = 36+J               ; arbre
  D$(4,J) = 40+J               ; montagne
NEXT
TILESET D$ 2 2 "~ #^M"
FILL T$ 32
FOR I 0 63
  T$(0,I) = 126
  T$(31,I) = 126
NEXT
FOR I 1 30
  T$(I,0) = 126
  T$(I,63) = 126
NEXT
REPEAT 12                      ; lacs
  Y = 1+RND(28)
  X = 1+RND(59)
  FOR I 0 1
    FOR J 0 2
      T$(Y+I,X+J) = 126
    NEXT
  NEXT
NEXT
REPEAT 150
  T$(1+RND(30),1+RND(62)) = 94
NEXT
REPEAT 25                      ; chaines de montagnes
  Y = 1+RND(30)
  X = 1+RND(60)
  T$(Y,X) = 77
  T$(Y,X+1) = 77
NEXT
REPEAT 8                       ; murs
  Y = 1+RND(30)
  X = 1+RND(57)
  FOR J 0 4
    T$(Y,X+J) = 35
  NEXT
NEXT
PX = 64                        ; joueur : caractere du monde
PY = 32
T$(16,32) = 32                 ; (tuile du joueur)
LORES
TFONT S$ 33 ALT
FOR L 1 26
  CHAR 0 L 9                   ; jeu secondaire : les tuiles
  CHAR 1 L 2
NEXT
CHAR 1 0 3
LOCATE 2 0
ECHO "CARTE : fleches, Q : fin"
CHAR 1 27 6
CALL CALC
WHILE 1
  K = INKEY
  IF K>7 & K<12
    NX = PX
    NY = PY
    IF K = 8
      NX = PX-1
    ENDIF
    IF K = 9
      NX = PX+1
    ENDIF
    IF K = 10
      NY = PY+1
    ENDIF
    IF K = 11
      NY = PY-1
    ENDIF
    IF TILE(NX,NY) = 1         ; herbe seulement
      PX = NX
      PY = NY
      CALL CALC
    ENDIF
  ENDIF
  IF K = 81 | K = 113          ; Q ou q : fin
    END
  ENDIF
NEXT

; CALC : fenetre centree sur le joueur, joueur et position
SUB CALC
  TMAP T$ PX-19 PY-13 2 1 38 26
  CHAR 21 14 44
  LOCATE 2 27
  ECHO "X "
  PRINT PX
  ECHO "  Y "
  PRINT PY
  ECHO "  "
ENDSUB
