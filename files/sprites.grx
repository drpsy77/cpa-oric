; SPRITES.GRX : un bonhomme mene aux fleches et une balle qui
; rebondit, poses sur un decor en mode texte (HEROS.SPR)
DIM S$(112) T(16)
BLOAD S$ HEROS.SPR
FOR I 0 15
  T(I) = 112+I         ; codes 112-127 : caracteres des sprites
NEXT
LORES
CHAR 0 0 6             ; titre en bleu clair
LOCATE 2 0
ECHO "FLECHES : BONHOMME   Q : FIN"
FOR L 1 27
  CHAR 0 L 2+(L%2)     ; vert et jaune, une ligne sur deux
  LOCATE 2 L
  IF L%3 = 0
    ECHO ":. . . . :. . . . :. . . . :. . . . :"
  ELSE
    ECHO "   .   .    .   .    .   .    .   .   "
  ENDIF
NEXT
SPRITES 2
SPOOL T
X = 10
Y = 12
B = 30
C = 4
D = 1
E = 1
WHILE 1
  K = INKEY
  IF K = 81 | K = 113          ; Q ou q : fin
    END
  ENDIF
  IF K = 8 & X > 2
    X = X - 1
  ENDIF
  IF K = 9 & X < 39
    X = X + 1
  ENDIF
  IF K = 10 & Y < 26
    Y = Y + 1
  ENDIF
  IF K = 11 & Y > 1
    Y = Y - 1
  ENDIF
  IF K > 0
    F = 1 - F          ; il marche
  ENDIF
  SSHOW 0 S$ F X Y
  B = B + D
  IF B = 2 | B = 39
    D = -D
  ENDIF
  C = C + E
  IF C = 1 | C = 27
    E = -E
  ENDIF
  SSHOW 1 S$ 2 B C
  DELAY 2
NEXT
