;;;; UN JEU DE TAQUIN ;;;;;


DIM T(5,5) A$(3,5) B$(41)

SC=0

LORES

LY=24
B$= "REMETTRE LES LIGNES A LEUR COULEUR"
CALL PCENTER
LY=LY+1
B$= "APPUYER SUR LA LETTRE OU LE CHIFFRE"
CALL PCENTER
LY=LY+1
B$= "DE LA LIGNE OU DE LA COLONNE"
CALL PCENTER
LY=LY+1
B$="    <Q> POUR QUITTER"
CALL PCENTER

SUB PCENTER
 LL=(40-LEN(B$))/2
 LOCATE LL LY
 PRINT B$
ENDSUB

FOR K 1 6
 CHAR K*5+2 3 64+K
 FOR I 0 5
  CHAR   2 I*3+5 I+1
  LOCATE 3 I*3+5
  PRINT I+1 
  FILL A$ I+17
  PASTE A$(0,0) K*5 I*3+4 5 3
 NEXT
NEXT

X=0
Y=0


;;; Pour essayer, retirer le ;
;;; devant le WHILE
;;; le jeu n'est alors pas melange
;;; et il n'y a rien a resoudre

; WHILE 0
FOR R 0 3
 FOR K 1 6
  ROTV (RND(6)-2)*3 K*5 4 (K+1)*5-1 21 
 NEXT
 FOR I 0 5
  ROTH ((RND(6)-2)*5) 5 (I*3)+4 34 (I+1)*3+3
 NEXT
NEXT
; NEXT

; boucle principale

WHILE 1
 GET K
 IF K=81 
   END
 ENDIF
 IF K>48 & K<55
  K=K-49
  ROTH 5 5 (K*3)+4 34 (K+1)*3+3
 ENDIF
 IF K>64 & K<71
  K=K-64
  ROTV 3 K*5 4 (K+1)*5-1 21
 ENDIF
 CALL ENDTEST
 SC=SC+1
NEXT 

SUB ENDTEST
 FOR Z 1 6
  FOR F 0 5
   IF SCRN(Z*5+2,F*3+5)<>F+17
    RETURN
   ENDIF
  NEXT
 NEXT
 DELAY 50
 CALL SCROLL
 LOCATE 2 25
 PRINT "BRAVO ! C'EST ENFIN REUSSI !"
 ECHO
 PRINT "     EN "
 PRINT SC
 PRINT " COUPS !"
 CALL SCROLL
 DELAY 100
 LOCATE 9 25
 PRINT "UNE TOUCHE POUR SORTIR"
 CALL SCROLL
 WAIT
 CALL SCROLL
 END
ENDSUB

SUB SCROLL
 FOR I 0 14
  SCROLV -1
 NEXT
ENDSUB
   