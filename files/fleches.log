POUR LIGNEH :L :C :F
  DONNE "I :C
  REPETE :F - :C + 1 [FIXECARECRAN :I :L 35 DONNE "I :I + 1]
FIN

POUR LIGNEV :C :L :F
  DONNE "I :L
  REPETE :F - :L + 1 [FIXECARECRAN :C :I 35 DONNE "I :I + 1]
FIN

POUR PAS
  FIXECARECRAN :X :Y 64
  DONNE "K TOUCHE
  SI VIDE? :K [ATTENDS 2 STOP]
  DONNE "A :X
  DONNE "B :Y
  SI :K = CAR 8 [DONNE "A :X - 1]
  SI :K = CAR 9 [DONNE "A :X + 1]
  SI :K = CAR 11 [DONNE "B :Y - 1]
  SI :K = CAR 10 [DONNE "B :Y + 1]
  SI (CARECRAN :A :B) = 32 [BOUGE]
  ATTENDS 2
FIN

POUR BOUGE
  FIXECARECRAN :X :Y 32
  DONNE "X :A
  DONNE "Y :B
  DONNE "N :N + 1
  FIXECURSEUR 30 26
  TAPE :N
FIN

POUR JEU
  ECRANTEXTE
  VT
  LIGNEH 2 2 39
