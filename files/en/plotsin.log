TO PLOTTER :X0 :X1 :Y0 :Y1 :STEP
  CS
  PU
  IF ( :X1 < :X0 ) [STOP]
  IF ( :Y1 < :Y0 ) [STOP]
  MAKE "IX ((:X1 - :X0 ) / 238 )
  MAKE "IY ((:Y1 - :Y0 ) / 126 )
  MAKE "YO ( -62 - (:Y0 / :IY ))
  MAKE "X :X0
  MAKE "Y (F :X )
  LINE -119 :YO 119 :YO
  LINE (-119 - (:X0 / :IX )) 64 (-119 - (:X0 / :IX )) -62
  REPEAT ( 238 / :STEP ) [ PLOTSTEP :STEP ]
END

TO PLOTSTEP :P
  MAKE "XA (:X + (:IX * :P ))
  MAKE "YA (F :XA )
  LINE (:X / :IX ) ((:Y / :IY ) + :YO ) (:XA / :IX ) ((:YA / :IY ) + :YO )
  MAKE "X :XA
  MAKE "Y :YA
END

TO F :X
  OUTPUT SIN :X
END

PLOTTER -180 180 -1 1 5
