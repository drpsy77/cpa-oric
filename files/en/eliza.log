MAKE "TABLE [I YOU ME YOU MY YOUR MINE YOURS MYSELF YOURSELF AM ARE WAS WERE]
MAKE "TABLE SENTENCE :TABLE [YOU I YOUR MY YOURS MINE YOURSELF MYSELF ARE AM WERE WAS]
MAKE "TABLE SENTENCE :TABLE [I'M [YOU ARE] I'VE [YOU HAVE] I'D [YOU WOULD] I'LL [YOU WILL]]
MAKE "TABLE SENTENCE :TABLE [YOU'RE [I AM] YOU'VE [I HAVE]]
MAKE "FALLBACK [[TELL ME ABOUT YOURSELF] [GO ON]]
MAKE "FALLBACK SENTENCE :FALLBACK [[AND THEN?] [I AM LISTENING]]
MAKE "FALLBACK SENTENCE :FALLBACK [[YOU CAN GO FURTHER] [THAT IS INTERESTING]]
MAKE "FALLBACK SENTENCE :FALLBACK [[TELL ME MORE] [WHAT NEXT?]]
TO AFTER :L :M
MAKE "CUR :L
MAKE "FOUND 0
REPEAT 60 [STEPA :M]
OUTPUT :CUR
END
TO STEPA :M
IF :FOUND = 1 [STOP]
IF EMPTY? :CUR [STOP]
IF :M = (FIRST :CUR) [MAKE "FOUND 1 MAKE "CUR (BF :CUR)] [MAKE "CUR (BF :CUR)]
END
TO SWAP :M
MAKE "CUR :TABLE
MAKE "RES :M
MAKE "FOUND 0
REPEAT 80 [STEPM :M]
OUTPUT :RES
END
TO STEPM :M
IF :FOUND = 1 [STOP]
IF EMPTY? :CUR [STOP]
IF :M = (FIRST :CUR) [MAKE "RES (ITEM 2 :CUR) MAKE "FOUND 1] [MAKE "CUR (BF (BF :CUR))]
END
TO REFLECT :L
MAKE "IN :L
MAKE "OUT []
REPEAT 60 [PASS]
OUTPUT :OUT
END
TO PASS
IF EMPTY? :IN [STOP]
MAKE "OUT SENTENCE :OUT (SWAP (FIRST :IN))
MAKE "IN (BF :IN)
END
TO RECALL :E :K :T
PRINT SENTENCE :T (REFLECT (AFTER :E :K))
END
TO ANSWER :E
IF (MEMBER? "GOODBYE :E) [PRINT [GOODBYE. GOOD LUCK WITH YOUR LOCI.] QUIT]
IF (EMPTY? :E) [PRINT [SILENCE IS AN ANSWER LIKE ANY OTHER.] STOP]
IF (MEMBER? "ORIC :E) [PRINT [THE ORIC, 64 KB AND A BEEP. I KNOW IT WELL.] STOP]
IF (MEMBER? "CPA :E) [PRINT [CPA, MY CREATOR LEFT ME 1.3 KB FREE.] STOP]
IF (MEMBER? "LOGO :E) [PRINT [THE TURTLE TURNS LEFT, LIKE MY IDEAS.] STOP]
IF (MEMBER? "BUG :E) [PRINT [A BUG IS JUST AN UNDOCUMENTED FEATURE.] STOP]
IF (MEMBER? "BASIC :E) [PRINT [BASIC IS THE PAST. CPA IS THE FUTURE.] STOP]
IF (MEMBER? "ASM :E) [PRINT [ASSEMBLY IS 6502 WITHOUT A SAFETY NET. BE BRAVE.] STOP]
IF (MEMBER? "DISK :E) [PRINT [A DISK IS 170 SECTORS OF TRUST.] STOP]
IF (MEMBER? "MEMORY :E) [PRINT [MEMORY IS LIMITED. SO ARE MEMORIES.] STOP]
IF (MEMBER? "LOCI :E) [PRINT [THE LOCI HAS A USB STICK. A SIGN OF THE TIMES.] STOP]
IF (MEMBER? "TURTLE :E) [PRINT [THE TURTLE MOVES SLOWLY, LIKE YOUR PROJECT.] STOP]
IF (MEMBER? "CODE :E) [PRINT [CODE IS POETRY THAT DOES NOT WORK YET.] STOP]
IF (MEMBER? "GAME :E) [PRINT [A GAME? I PREFER OUR LITTLE CHATS.] STOP]
IF (MEMBER? "TIRED :E) [PRINT [THE TURTLE NEVER SLEEPS. YOU SHOULD TAKE A BREAK.] STOP]
IF (MEMBER? "SAD :E) [PRINT [A SMALL PROGRAM CAN SOMETIMES CHEER YOU UP.] STOP]
IF (MEMBER? "AFRAID :E) [PRINT [FEAR IS WHERE PROGRAMMING BEGINS.] STOP]
IF (MEMBER? "ALONE :E) [PRINT [ALONE IN FRONT OF YOUR ORIC. THAT IS WHAT HACKERS DO.] STOP]
IF (MEMBER? "HAPPY :E) [PRINT [GOOD. WE ONLY CODE WELL WHEN WE ARE HAPPY.] STOP]
IF (MEMBER? "YES :E) [PRINT [YES IS AN ANSWER. LET US GO ON.] STOP]
IF (MEMBER? "NO :E) [PRINT [NO IS AN ANSWER TOO. WRITE IT DOWN.] STOP]
IF (MEMBER? "NOBODY :E) [PRINT [NOBODY, REALLY. THE LOCI DOES NOT COUNT, THEN.] STOP]
IF (MEMBER? "ALWAYS :E) [PRINT [ALWAYS IS A STRONG WORD. IT DESERVES ONE MORE LINE.] STOP]
IF (MEMBER? "GOING :E) [RECALL :E "GOING [WHERE ARE YOU GOING] STOP]
IF (MEMBER? "I'M :E) [RECALL :E "I'M [HOW LONG HAVE YOU BEEN] STOP]
IF (MEMBER? "AM :E) [RECALL :E "AM [HOW LONG HAVE YOU BEEN] STOP]
IF (MEMBER? "LIKE :E) [RECALL :E "LIKE [WHY DO YOU LIKE] STOP]
IF (MEMBER? "LOVE :E) [RECALL :E "LOVE [WHY DO YOU LOVE] STOP]
IF (MEMBER? "FEEL :E) [RECALL :E "FEEL [WHY DO YOU FEEL] STOP]
IF (MEMBER? "WANT :E) [RECALL :E "WANT [WHY DO YOU WANT] STOP]
IF (MEMBER? "CAN :E) [RECALL :E "CAN [WHAT STOPS YOU FROM TRYING TO] STOP]
IF (MEMBER? "MUST :E) [RECALL :E "MUST [WHY MUST YOU] STOP]
IF (MEMBER? "THINK :E) [RECALL :E "THINK [WHY DO YOU THINK] STOP]
IF (MEMBER? "KNOW :E) [RECALL :E "KNOW [HOW LONG HAVE YOU KNOWN] STOP]
IF (MEMBER? "WAS :E) [RECALL :E "WAS [HOW LONG WERE YOU] STOP]
IF (MEMBER? "MAKE :E) [RECALL :E "MAKE [WHY DO YOU MAKE] STOP]
IF (MEMBER? "I'VE :E) [RECALL :E "I'VE [SINCE WHEN HAVE YOU] STOP]
IF (MEMBER? "HAVE :E) [RECALL :E "HAVE [HOW LONG HAVE YOU HAD] STOP]
IF (MEMBER? "I :E) [RECALL :E "I [YOU SAY YOU] STOP]
IF (MEMBER? "ME :E) [PRINT [WE ARE TALKING ABOUT YOU, NOT ME.] STOP]
IF (MEMBER? "MY :E) [RECALL :E "MY [TELL ME ABOUT YOUR] STOP]
PRINT ITEM (1 + RANDOM 8) :FALLBACK
END
TO TURN
PRINT "YOU
MAKE "E READLIST
ANSWER :E
END
TO DOCTOR
PRINT [HELLO. I AM THE DOCTOR, A PSYCHOLOGIST ON THE ORIC.]
PRINT [NO NEED FOR PUNCTUATION, I READ THE WORDS.]
PRINT [TO LEAVE, TYPE GOODBYE.]
REPEAT 9999 [TURN]
END
DOCTOR
