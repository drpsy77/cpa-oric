TO SQUARE :S
REPEAT 4 [FD :S RT 90]
END

TO POLY :N :S
REPEAT :N [FD :S RT 360 / :N]
END

TO STAR :S
REPEAT 5 [FD :S RT 144]
END

TO FLOWER
REPEAT 12 [SQUARE 25 RT 30]
END

TO SPIRAL :N
IF :N > 110 [STOP]
FD :N RT 91
SPIRAL :N + 3
END

TO TREE :L
IF :L < 4 [STOP]
FD :L LT 30 TREE :L * 2 / 3
RT 60 TREE :L * 2 / 3
LT 30 BK :L
END

TO DEMO
CS FLOWER
WAIT 100
CS PU SETXY 0 -60 PD TREE 36
END
