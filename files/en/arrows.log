POUR HLINE :L :C :F
  DONNE "I :C
  REPETE :F - :C + 1 [FIXECARECRAN :I :L 35 DONNE "I :I + 1]
FIN

POUR VLINE :C :L :F
  DONNE "I :L
  REPETE :F - :L + 1 [FIXECARECRAN :C :I 35 DONNE "I :I + 1]
FIN

POUR STEP
  FIXECARECRAN :X :Y 64
  DONNE "K TOUCHE
  SI VIDE? :K [ATTENDS 2 STOP]
  DONNE "A :X
  DONNE "B :Y
  SI :K = CAR 8 [DONNE "A :X - 1]
  SI :K = CAR 9 [DONNE "A :X + 1]
  SI :K = CAR 11 [DONNE "B :Y - 1]
  SI :K = CAR 10 [DONNE "B :Y + 1]
  SI (CARECRAN :A :B) = 32 [MOVE]
  ATTENDS 2
FIN

POUR MOVE
  FIXECARECRAN :X :Y 32
  DONNE "X :A
  DONNE "Y :B
  DONNE "N :N + 1
  FIXECURSEUR 30 26
  TAPE :N
FIN

POUR GAME
  ECRANTEXTE
  VT
  HLINE 2 2 39
  HLINE 24 2 39
  VLINE 2 3 23
  VLINE 39 3 23
  VLINE 20 7 19
  FIXECURSEUR 3 1
  TAPE [ARROWS: the @ with TOUCHE]
  FIXECURSEUR 3 26
  TAPE [Arrows, ESC: end]
  FIXECURSEUR 23 26
  TAPE [Steps: 0]
  DONNE "X 10
  DONNE "Y 13
  DONNE "N 0
  REPETE 32000 [STEP]
FIN

GAME
