TO HLINE :L :C :F
  MAKE "I :C
  REPEAT :F - :C + 1 [SETCELL :I :L 35 MAKE "I :I + 1]
END

TO VLINE :C :L :F
  MAKE "I :L
  REPEAT :F - :L + 1 [SETCELL :C :I 35 MAKE "I :I + 1]
END

TO STEP
  SETCELL :X :Y 64
  MAKE "K KEY
  IF EMPTY? :K [WAIT 2 STOP]
  MAKE "A :X
  MAKE "B :Y
  IF :K = CHAR 8 [MAKE "A :X - 1]
  IF :K = CHAR 9 [MAKE "A :X + 1]
  IF :K = CHAR 11 [MAKE "B :Y - 1]
  IF :K = CHAR 10 [MAKE "B :Y + 1]
  IF (CELL :A :B) = 32 [MOVE]
  WAIT 2
END

TO MOVE
  SETCELL :X :Y 32
  MAKE "X :A
  MAKE "Y :B
  MAKE "N :N + 1
  SETCURSOR 30 26
  TYPE :N
END

TO GAME
  TEXTSCREEN
  CT
  HLINE 2 2 39
  HLINE 24 2 39
  VLINE 2 3 23
  VLINE 39 3 23
  VLINE 20 7 19
  SETCURSOR 3 1
  TYPE [ARROWS: the @ with KEY]
  SETCURSOR 3 26
  TYPE [Arrows, ESC: end]
  SETCURSOR 23 26
  TYPE [Steps: 0]
  MAKE "X 10
  MAKE "Y 13
  MAKE "N 0
  REPEAT 32000 [STEP]
END

GAME
