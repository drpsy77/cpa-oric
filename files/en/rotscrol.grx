; BDD.GRX: DATABASE                    
; IDEA: THE DATA IS STORED             
; IN A TWO-DIMENSIONAL ARRAY           
; EACH LINE HOLDS A STRING             
                                       
DIM E$(60,40)                          
FILL E$ 32                             
LOAD E$ ROTSCROL.GRX                   
LORES                                  
PASTE E$(0,0) 1 1 39 27                
WAIT                                   
LOCATE 1 2                             
PRINTV "                       "        
LOCATE 3 2                             
PRINTV "                       "       
LOCATE 2 2                             
PRINTV "HELLO, VERTICAL TEXT"          
                                      
WAIT                                   
PRINT " HELLO, HORIZONTAL TEXT"        
LOCATE 3 1                             
WAIT                                   
PRINT "HELLO, HORIZONTAL TEXT"         
                                       
WAIT                                   
PRINTV " HELLO, VERTICAL TEXT"         
                                       
WAIT                                   
FOR I 0 30                             
ROTH -1 0 0 39 27                      
DELAY 1                               
NEXT                                   
FOR I 0 50                             
ROTH  1 0 0 39 27                      
DELAY 1                               
NEXT                                   
FOR I 0 40                             
ROTV -1 0 0 39 27                      
DELAY 1                               
NEXT                                   
FOR I 0 40                             
ROTV  1 0 0 39 27                      
DELAY 1                               
NEXT                                   
FOR I 0 60                             
ROTH -1 0 0 39 27                      
DELAY 1                               
NEXT                                   
FOR I 0 40                             
SCROLH -1 0 0 39 27 32                
DELAY 1                                
NEXT                                   
