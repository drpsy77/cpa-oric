; boucles traduites en ligne par GRXASM : memes resultats qu'en
; interprete (compteur d'un octet, 16 bits, arrivee calculee, REPEAT)
S = 0
FOR I 0 9
  S = S + I
NEXT
PRINT S " " I
N = 0
FOR I 0 254
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I 0 255
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I 250 260
  N = N + 1
NEXT
PRINT N " " I
FOR I 3 3
  PRINT I
NEXT
I = 77
FOR I 5 4
  PRINT 999
NEXT
PRINT I
FOR I -3 3
  PRINT I
NEXT
PRINT I
FOR I 3 -3 -1
  PRINT I
NEXT
PRINT I
FOR I 10 1 -3
  PRINT I
NEXT
PRINT I
FOR I -5 -1 2
  PRINT I
NEXT
PRINT I
FOR I 0 9 2
  PRINT I
NEXT
PRINT I
N = 0
FOR I 0 1000 256
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I 0 -1000 -256
  N = N + 1
NEXT
PRINT N " " I
; bornes calculees
A = 2
B = 7
FOR I A B
  PRINT I
NEXT
PRINT I
FOR I B A -1
  PRINT I
NEXT
PRINT I
FOR I A B 2
  PRINT I
NEXT
PRINT I
FOR I B A
  PRINT 999
NEXT
PRINT I
FOR I 0 (B-A)
  PRINT I
NEXT
PRINT I
FOR I A 4
  PRINT I
NEXT
PRINT I
FOR I B 4
  PRINT 999
NEXT
PRINT I
FOR I B 4 -1
  PRINT I
NEXT
PRINT I
FOR I 1 (I+2)
  PRINT I
NEXT
PRINT I
; variable ecrite dans le corps
N = 0
FOR I 0 9
  N = N + 1
  IF I = 3
    I = 7
  ENDIF
NEXT
PRINT N " " I
N = 0
FOR I 0 9
  N = N + 1
  IF I = 2
    I = 300
  ENDIF
NEXT
PRINT N " " I
N = 0
F = 0
FOR I 0 5
  N = N + 1
  IF I = 2 & F = 0
    F = 1
    I = -3
  ENDIF
NEXT
PRINT N " " I
; variable ecrite par un sous-programme
N = 0
FOR I 0 9
  N = N + 1
  CALL SAUTE
NEXT
PRINT N " " I
; boucles l'une dans l'autre, variables a deux caracteres
S = 0
FOR I 0 3
  FOR J 0 3
    S = S + I*J
  NEXT
NEXT
PRINT S " " I " " J
S = 0
FOR I1 0 5
  FOR AB 1 3
    S = S + I1 + AB
  NEXT
NEXT
PRINT S " " I1 " " AB
S = 0
FOR I 0 3
  FOR I 0 2
    S = S + 1
  NEXT
NEXT
PRINT S " " I
; au bout des entiers
N = 0
FOR I 32760 32767
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I -32760 (-32767-1) -1
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I 32000 32767 500
  N = N + 1
NEXT
PRINT N " " I
N = 0
FOR I 32000 32766
  N = N + 1
NEXT
PRINT N " " I
; REPEAT
N = 0
REPEAT 0
  N = N + 1
NEXT
PRINT N
REPEAT 1
  N = N + 1
NEXT
PRINT N
REPEAT 255
  N = N + 1
NEXT
PRINT N
REPEAT 256
  N = N + 1
NEXT
PRINT N
REPEAT 700
  N = N + 1
NEXT
PRINT N
REPEAT -4
  N = N + 1
NEXT
PRINT N
REPEAT A
  N = N + 1
NEXT
PRINT N
REPEAT 3
  REPEAT 4
    N = N + 1
  NEXT
NEXT
PRINT N
SUB SAUTE
  IF I = 4
    I = 6
  ENDIF
ENDSUB
