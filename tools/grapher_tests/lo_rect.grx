; LORES : SCROLH SCROLV ROTH ROTV (rectangles, signe, octet), PRINTV
; ECHOV SPCV, PASTE GRAB
LORES
FOR L 0 4
  LOCATE 2 L
  ECHO ABCDEFGH
NEXT
SCROLH 1 2 0 9 0
SCROLH -2 2 1 9 1 45
ROTH 3 2 2 9 2
ROTH -1 2 3 9 3
ROTH 10 2 4 9 4
FOR L 6 10
  CHAR 12 L 42+L
  CHAR 13 L 91+L
  CHAR 14 L 59+L
  CHAR 15 L 80+L
  CHAR 16 L 43+L
  CHAR 17 L 120
NEXT
SCROLV 1 12 6 12 10
SCROLV -2 13 6 13 10 42
ROTV 1 14 6 14 10
ROTV -7 15 6 15 10
ROTV 4 16 6 16 10
SCROLV 9 17 6 17 10
ROTV -1
ROTV 1
ROTH 40
ROTH 1
ROTH -1
SCROLH 0
LOCATE 20 0
PRINTV 123
PRINTV -4
ECHOV AB
ECHOV
ECHOV "X Y"
SPCV 3 61
LOCATE 22 25
ECHOV LONGUE
LOCATE 22 12
PRINT 9
PRINT 8
DIM S$(5) T$(10,20)
S$ = "VERT"
LOCATE 24 0
PRINTV S$
FOR I 0 9
  FOR J 0 19
    T$(I,J) = 65+((I+J)%26)
  NEXT
NEXT
PASTE T$(2,3) 26 14 5 3
GRAB T$(0,0) 26 14 2 2
PASTE T$(0, 0) 33 14 3 2
LOCATE 0 20
PRINT T$(1,1)
