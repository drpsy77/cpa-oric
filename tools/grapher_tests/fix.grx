; tableaux a adresse fixe (GRXASM) : indices constants, variables,
; calcules ; petits et grands tableaux ; meme resultat interprete et traduit
N = 3
IF N > 0
 DIM Z(4)
ENDIF
DIM K(N+2)
DIM S(5) B$(6) G(4,3) M$(5,4) W(200) V$(30,20) P(4)
; une dimension, entiers
S(0) = 7
S(4) = S(0) * 2
S(2) = -1
PRINT S(0) + S(4) + S(2)
I = 1
S(I) = 300
S(I+2) = S(I) + 1
PRINT S(1)
PRINT S(3)
A = 100
PRINT A - S(3)
PRINT A - S(I)
PRINT A < S(I+2)
S(I) = A
PRINT S(1)
S(I) = S(I) + 1
PRINT S(I)
; une dimension, octets
B$(0) = 65
B$(I) = 66
B$(I+1) = B$(I) + 1
J = 68
B$(3) = J
PRINT B$
PRINT LEN(B$)
PRINT B$(2)
PRINT B$(3)
; deux dimensions, entiers : constantes, variables, calculs
FOR I 0 2
 FOR J 0 3
  G(J,I) = I * 10 + J
 NEXT
NEXT
I = 2
J = 3
PRINT G(2,1)
PRINT G(J,I)
PRINT G(1,I)
PRINT G(J,0)
PRINT G(J-1,I-1)
PRINT G(2,I-1)
PRINT G(J-2,1)
PRINT G(J-1,I)
PRINT G(7)
PRINT G(I*4)
G(J,I) = 99
G(J-1,1) = 55
G(0,I-1) = G(J,I) + G(2,1)
PRINT G(3,2)
PRINT G(2,1)
PRINT G(0,1)
PRINT A - G(J,I)
PRINT A - G(2,1)
; deux dimensions, octets ; lignes en chaines
FILL M$ 46
M$(1) = "ABC"
M$(J,I) = 90
M$(J-1,0) = 89
M$(0,I+1) = M$(1,1)
PRINT M$(1)
PRINT M$(2)
PRINT M$(0)
PRINT M$(3)
PRINT M$(1) = "ABC"
PRINT M$(J,I) + M$(2,0)
; indice qui lit un tableau
P(0) = 2
P(1) = 3
P(2) = 1
PRINT S(P(2))
PRINT G(P(1),P(2))
PRINT G(P(P(2)),P(0)-1)
; grands tableaux : par le descripteur, sauf les indices constants
FOR I 0 199
 W(I) = I * 2
NEXT
PRINT W(150)
PRINT W(199)
PRINT W(I-50)
W(5) = 1234
PRINT W(5) + W(6)
V$(29,19) = 42
I = 19
V$(10,I) = 43
V$(0) = "OK"
PRINT V$(29,19)
PRINT V$(29,I)
PRINT V$(10,19)
PRINT V$(0)
; noms de deux caracteres, minuscules, espaces dans les parentheses
PX = 2
PY = 1
g(px,py) = 77
PRINT G(2,1)
PRINT s( py )
S(PX) = PY + 40
PRINT S(2)
; tableaux ordinaires a cote
Z(3) = 5
K(4) = 6
PRINT Z(3) + K(4)
FILL S 9
PRINT S(0) + S(5-1)
CALL T
PRINT S(2)
END
SUB T
 S(2) = S(2) + G(3,2)
ENDSUB
