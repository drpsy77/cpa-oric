; test du palier 3
X = 5
Y = X * 3 + 2
PRINT Y
PRINT (Y - 20) / 3
PRINT 17 % 5
PRINT -17 % 5
PRINT 3 < 5
PRINT 5 <= 4
PRINT 2+3*4 = 14
PRINT ABS(-7)
PRINT 1000*30
PRINT -2*-3
LET Z = 100
REPEAT 3
  Z = Z + 1
NEXT
PRINT Z
FOR I 1 10 3
  PRINT I
NEXT
FOR I 5 1 -2
  PRINT I
NEXT
FOR I 1 0
  PRINT 999
NEXT
N = 0
WHILE N < 3
  N = N + 1
NEXT
PRINT N
IF N = 3
  PRINT 11
ELSE
  PRINT 0
ENDIF
IF N > 5
  PRINT 0
ELSE
  IF N = 3
    PRINT 22
  ENDIF
ENDIF
REPEAT 2
  REPEAT 2
    K = K + 1
  NEXT
NEXT
PRINT K
CALL DOUBLE
PRINT D
PRINT RND(10) < 10
PRINT (1 & 1) | 0
REPEAT 0
  PRINT 999
NEXT
PRINT 32767
SUB DOUBLE
  D = N * 2
  IF D > 1
    RETURN
  ENDIF
  D = 999
ENDSUB
PRINT 77
