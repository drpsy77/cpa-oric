; SPLIT : glissements et copies dans l'image (POINT)
SPLIT
GCLS
PLOT 6 10
SCROLV 5
PRINT POINT(6,15)
PRINT POINT(6,10)
SCROLH 1
PRINT POINT(12,15)
ROTV -20
PRINT POINT(12,123)
ROTH -2
PRINT POINT(0,123)
SCROLH -1 0 123 39 123
PRINT POINT(0,123)
DIM B$(2,2)
B$(0,0) = 127
PASTE B$(0,0) 5 50 1 1
PRINT POINT(33,50)
PRINT POINT(36,50)
GRAB B$(1,1) 5 50 1 1
PRINT B$(1,1)
