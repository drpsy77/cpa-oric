; sprite sur des tuiles (masque) : jeu secondaire, puis standard ;
; SHIDE rend la tuile
DIM S$(48) H$(48) D$(1,2) T$(4,2) T(2) U(2)
BLOAD S$ TUIL.SPR
BLOAD H$ HERO.SPR
LORES
TFONT S$ 40 ALT          ; UN : 40, DEUX : 41-42 (jeu secondaire)
TFONT S$ 70              ; UN : 70, DEUX : 71-72 (jeu standard)
T$(1,0) = 1
T$(2,1) = 1
CHAR 0 1 9
CHAR 0 2 9
D$(0,0) = 40
D$(0,1) = 41
TILESET D$ 1 1
TMAP T$ 0 0 2 1 4 2
D$(0,0) = 70
D$(0,1) = 71
TILESET D$ 1 1
TMAP T$ 0 0 2 4 4 2
T(0) = 100
T(1) = 101
U(0) = 110
U(1) = 111
SPRITES 2
SPOOL T ALT
SPOOL U
SSHOW 0 H$ 0 3 1 ALT     ; sur UN puis DEUX (jeu secondaire)
SSHOW 1 H$ 0 3 4         ; sur DEUX puis UN (jeu standard)
SSHOW 1 H$ 0 4 4         ; deplace : la tuile revient en (3,4) et (3,5)
