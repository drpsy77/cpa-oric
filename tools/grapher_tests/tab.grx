; Palier B : DIM, elements, FILL, lecture a plat
DIM S(5) G(3,4) B$(6)
S(0) = 7
S(4) = S(0) * 2
PRINT S(0) + S(4)
FOR I 0 2
  FOR J 0 3
    G(I,J) = I * 10 + J
  NEXT
NEXT
PRINT G(2,3)
PRINT G(7)
; G(1,3) = G(7) : le tableau mis a plat, ligne apres ligne
PRINT G(1,3) = G(7)
B$(2) = 65
PRINT B$(2) + 1
FILL S 3
PRINT S(1) + S(4)
FILL G -1
PRINT G(0,0) + G(2,3)
N = 4
DIM T(N+1,N*2)
T(N,7) = 99
PRINT T(4,N+3)
X = (S(2) + 1) * G(1,1)
PRINT X
