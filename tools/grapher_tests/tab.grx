; Palier B : DIM, elements, FILL, lecture a plat
DIM S(5) G(4,3) B$(6)
S(0) = 7
S(4) = S(0) * 2
PRINT S(0) + S(4)
FOR I 0 2
  FOR J 0 3
    G(J,I) = I * 10 + J
  NEXT
NEXT
PRINT G(3,2)
PRINT G(7)
; G(3,1) = G(7) : le tableau mis a plat, ligne apres ligne
PRINT G(3,1) = G(7)
B$(2) = 65
PRINT B$(2) + 1
FILL S 3
PRINT S(1) + S(4)
FILL G -1
PRINT G(0,0) + G(3,2)
N = 4
DIM T(N*2,N+1)
T(7,N) = 99
PRINT T(N+3,4)
X = (S(2) + 1) * G(1,1)
PRINT X
