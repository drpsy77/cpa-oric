POUR FACT :N
SI :N < 2 [RENDS 1]
RENDS :N * FACT :N - 1
FIN
POUR FIBO :N
SI :N < 2 [RENDS :N]
RENDS (FIBO :N - 1) + (FIBO :N - 2)
FIN
POUR CARRE :X
RENDS :X * :X
FIN
POUR SOMME :A :B
RENDS :A + :B
FIN
POUR INVERSE.M :M
SI VIDE? :M [RENDS "]
RENDS MOT INVERSE.M SAUFPREMIER :M PREMIER :M
FIN
POUR SUITE :N
SI :N = 0 [RENDS []]
RENDS PHRASE :N SUITE :N - 1
FIN
POUR UN
EXECUTE [RENDS 1]
FIN
POUR MONTRE :X
ECRIS :X
FIN
POUR PROF :N
SI :N = 0 [RENDS 0]
RENDS 1 + PROF :N - 1
FIN
POUR MILIEU
FIXEXY 10 20
RENDS XCOR
FIN
ECRIS FACT 5
ECRIS FACT 10
ECRIS FACT 20
ECRIS FIBO 12
ECRIS SOMME CARRE 3 CARRE 4
ECRIS (CARRE 2) + CARRE 2 + 1
ECRIS INVERSE.M "BONJOUR
ECRIS SUITE 12
ECRIS ITEM 3 SUITE 5
ECRIS MOT CARRE 2 CARRE 3
ECRIS UN + UN
EXECUTE [ECRIS CARRE 5]
MONTRE CARRE 6
REPETE 2 [ECRIS SOMME 1 2]
SI (CARRE 3) = 9 [ECRIS "OUI]
ECRIS PROF 35
REPETE 60 [DONNE "Z SUITE 25]
ECRIS COMPTE :Z
ECRIS PREMIER :Z
FIXEXY 50 MILIEU
ECRIS LISTE XCOR YCOR
ORIGINE
