    //LOCI identity marker
    IOREGS(0x0319) = 'L';
 
+    //DIAG (ACIA read path probe, CP/A test build)
+    //  $0384-$0387 and $0344-$0347 : fixed pattern A5 5A 0F F0
+    //  $0388 : count of status ($0381) reads seen by the LOCI
+    //  $0389 : count of writes to $0380-$0383 seen by the LOCI
+    //  $038A / $038B : last CMD / CTRL byte written, as seen on the bus
+    //  $038C : bit 0 modem mounted, bit 1 DTR on
+    //  $038D : $D1 (diag build marker)
+    {
+        static const uint8_t pat[4] = {0xA5, 0x5A, 0x0F, 0xF0};
+        for(int i=0; i<4; i++){
+            IOREGS(0x0384 + i) = pat[i];
+            IOREGS(0x0344 + i) = pat[i];
+        }
+        for(int i=0x0388; i<=0x038F; i++)
+            IOREGS(i) = 0x00;
+        IOREGS(0x038D) = 0xD1;
+        //Read response on $0384-$038F (bits 1-3 of map[1]) and $0344-$0347 (bit 17 of map[0])
+        for(int i=(0x84 >> 2); i<=(0x8F >> 2); i++)
+            mia_iopage_read_enable_map[1] |= (0x1UL << (i & 0x1F));
+        mia_iopage_read_enable_map[0] |= (0x1UL << ((0x44 >> 2) & 0x1F));
+    }
+
     mia_boot_settings = 0;
