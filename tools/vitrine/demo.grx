; DEMO.GRX : l'atelier de la vitrine (tools/vitrine.py). Le meme
; programme, interprete par GRAPHER, puis traduit par GRXASM,
; assemble par ASM et lance (DEMO.COM), enfin mis en cassette.
;   GRAPHER DEMO
; Le fond, un losange de couleurs : 41 couleurs calculees une fois
; (table C$), puis 340 paires de cases lues dans la table. Il montre
; l'ecart de vitesse ; le defilement est cadence par DELAY : meme
; vitesse dans les deux versions, que la page web suit.
LORES
DIM G$(36) C$(41)
N = 7
FOR A 0 40
  C$(A) = 17+A/3%7
NEXT
FOR L 0 27
  LOCATE 0 L
  IF L<8 | L>18
    Y = ABS(L-14)*3/2
    FOR A (Y+19) (Y+1) -2
      SPC 2 C$(A)
    NEXT
    FOR A (Y+1) (Y+19) 2
      SPC 2 C$(A)
    NEXT
  ELSE
    SPC 40 16
  ENDIF
NEXT
; BONJOUR, 7 lettres de 5 rangees de 3 points (0-7, bit 2 a gauche)
G$ = "65656755576555511157755575555765655"
X = 20-2*N
FOR K 0 (N-1)
  FOR R 0 4
    V = G$(5*K+R)-48
    W = 4
    FOR J 0 2
      IF V/W%2
        CHAR (X+4*K+J) (10+R) (17+K%7)
      ENDIF
      W = W/2
    NEXT
  NEXT
NEXT
LOCATE 6 17
PRINT "Ecrit et compile sur l'Oric"
REPEAT 80
  ROTH 1 0 10 39 14
  DELAY 4
NEXT
DELAY 50
