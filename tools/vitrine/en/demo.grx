; DEMO.GRX: the showcase workshop (tools/vitrine.py). The same
; program, interpreted by GRAPHER, then translated by GRXASM,
; assembled by ASM and run (DEMO.COM), lastly put on tape.
;   GRAPHER DEMO
; The background, a colour diamond: 41 colours computed once (table
; C$), then 340 pairs of cells read from the table. It shows the speed
; gap; the scrolling is paced by DELAY: same speed in both versions,
; which the web page can follow.
LORES
DIM G$(36) C$(41)
N = 5
FOR A 0 40
  C$(A) = 17+A/3%7
NEXT
FOR L 0 27
  LOCATE 0 L
  IF L<8 | L>18
    Y = ABS(L-14)*3/2
    FOR A (Y+19) (Y+1) -2
      SPC 2 C$(A)
    NEXT
    FOR A (Y+1) (Y+19) 2
      SPC 2 C$(A)
    NEXT
  ELSE
    SPC 40 16
  ENDIF
NEXT
; HELLO, 5 letters of 5 rows of 3 dots (0-7, bit 2 on the left)
G$ = "5575574647444474444775557"
X = 20-2*N
FOR K 0 (N-1)
  FOR R 0 4
    V = G$(5*K+R)-48
    W = 4
    FOR J 0 2
      IF V/W%2
        CHAR (X+4*K+J) (10+R) (17+K%7)
      ENDIF
      W = W/2
    NEXT
  NEXT
NEXT
LOCATE 4 17
PRINT "Written and compiled on the Oric"
REPEAT 80
  ROTH 1 0 10 39 14
  DELAY 4
NEXT
DELAY 50
