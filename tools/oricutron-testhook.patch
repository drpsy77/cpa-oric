+/* CP/A : couleurs de l'Oric dans oricutron.cfg, colour0 = '#000000' ...
+   colour7 = '#FFFFFF' (RRGGBB en hexadecimal, # facultatif) */
+static SDL_bool read_config_colour(char *buf)
+{
+  extern Uint8 oricpalette[];
+  char tok[8], val[16], *p;
+  unsigned int rgb;
+  int c;
+
+  for(c=0; c<8; c++)
+  {
+    sprintf(tok, "colour%d", c);
+    if(!read_config_string(buf, tok, val, sizeof(val))) continue;
+    p = (val[0] == '#') ? val+1 : val;
+    if((strlen(p) == 6) && (strspn(p, "0123456789abcdefABCDEF") == 6) &&
+       (sscanf(p, "%x", &rgb) == 1))
+    {
+      oricpalette[c*3  ] = (rgb>>16)&0xff;
+      oricpalette[c*3+1] = (rgb>>8)&0xff;
+      oricpalette[c*3+2] = rgb&0xff;
+    }
+    return SDL_TRUE;
+  }
+  return SDL_FALSE;
+}
+
+/* CP/A : loci = 'dossier' simule le LOCI avec ce dossier pour clé USB
+   (~/ = dossier personnel ; chemin relatif : à côté d'Oricutron) */
+static SDL_bool read_config_loci(char *buf)
+{
+  extern char loci_dir[1024];
+  char tmp[1024];
+  const char *home = getenv("HOME");
+
+  if(!read_config_string(buf, "loci", tmp, sizeof(tmp))) return SDL_FALSE;
+  if((tmp[0] == '~') && (tmp[1] == '/') && home)
+    snprintf(loci_dir, sizeof(loci_dir), "%s%s", home, tmp+1);
+  else
+  {
+    snprintf(loci_dir, sizeof(loci_dir), "%s", tmp);
+    if(loci_dir[0]) add_fileprefix(loci_dir, sizeof(loci_dir));
+  }
+  return SDL_TRUE;
+}
