+void EMSCRIPTEN_KEEPALIVE cpa_www_reset(void)
+{
+  gCtx->oric.cpu.nmi = SDL_TRUE;   /* bouton RESET de l'Atmos : NMI */
+  gCtx->oric.cpu.nmicount = 2;
+}
+int EMSCRIPTEN_KEEPALIVE cpa_www_flush(void)   /* écrit la disquette modifiée */
+{
+  int i, n = 0;
+  for (i = 0; i < 4; i++)
+    if (gCtx->oric.wddisk.disk[i] && gCtx->oric.wddisk.disk[i]->modified) {
+      diskimage_save(&gCtx->oric, gCtx->oric.wddisk.disk[i]->filename, i);
+      n++;
+    }
+  return n;
+}
+#endif
