+{
+  gCtx->oric.cpu.nmi = SDL_TRUE;   /* bouton RESET de l'Atmos : NMI */
+  gCtx->oric.cpu.nmicount = 2;
+}
+int EMSCRIPTEN_KEEPALIVE cpa_www_flush(void)   /* écrit la disquette modifiée */
+{
