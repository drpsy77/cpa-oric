 /* Tasks to do once per emulated frame */
+void cpa_kbd_tick(void);   /* keyboard.c : maintien des touches du clavier dessiné */
+
+/* --- collage (F12, menu) pour CP/A : le presse-papiers est tapé sur la
+   matrice du clavier simulé, ce qui marche avec tout logiciel (CP/A, LOGO,
+   EDIT, BASIC) et non seulement avec la routine clavier de la ROM BASIC.
+   Tables : src/tables.s de CP/A (clavier de l'Atmos, index = matrice). --- */
+static const unsigned char cpa_knorm[64] = {
+    0x37,0x6E,0x35,0x76,0x00,0x31,0x78,0x33,0x6A,0x74,0x72,0x66,0x00,0x1B,0x71,0x64,
+    0x6D,0x36,0x62,0x34,0x00,0x7A,0x32,0x63,0x6B,0x39,0x3B,0x2D,0x00,0x00,0x5C,0x27,
+    0x20,0x2C,0x2E,0x0B,0x00,0x08,0x0A,0x09,0x75,0x69,0x6F,0x70,0x00,0x7F,0x5D,0x5B,
+    0x79,0x68,0x67,0x65,0x00,0x61,0x73,0x77,0x38,0x6C,0x30,0x2F,0x00,0x0D,0x00,0x3D };
+static const unsigned char cpa_kshift[64] = {
+    0x26,0x4E,0x25,0x56,0x00,0x21,0x58,0x23,0x4A,0x54,0x52,0x46,0x00,0x1B,0x51,0x44,
+    0x4D,0x5E,0x42,0x24,0x00,0x5A,0x40,0x43,0x4B,0x28,0x3A,0x5F,0x00,0x00,0x7C,0x22,
+    0x20,0x3C,0x3E,0x0B,0x00,0x08,0x0A,0x09,0x55,0x49,0x4F,0x50,0x00,0x7F,0x7D,0x7B,
+    0x59,0x48,0x47,0x45,0x00,0x41,0x53,0x57,0x2A,0x4C,0x29,0x3F,0x00,0x0D,0x00,0x2B };
+static char *cpa_pbuf = NULL;
+static int cpa_plen = 0, cpa_ppos = 0;
+void cpa_paste(const char *text)
+{
+  int n, i;
+  char *b;
+  if (!text) return;
+  n = (int)strlen(text);
+  if (cpa_pbuf && cpa_ppos >= cpa_plen) { free(cpa_pbuf); cpa_pbuf = NULL; cpa_plen = cpa_ppos = 0; }
+  b = realloc(cpa_pbuf, cpa_plen + n + 1);
+  if (!b) return;
+  cpa_pbuf = b;
+  for (i = 0; i < n; i++) {
+    unsigned char c = (unsigned char)text[i];
+    if (c == '\n' && i > 0 && text[i-1] == '\r') continue;   /* CR LF */
+    if (c == '\n') c = '\r';
+    if (c == '\t') c = ' ';
+    if (c != '\r' && (c < 0x20 || c >= 0x7F)) continue;    /* accents, etc. : ignorés */
+    cpa_pbuf[cpa_plen++] = (char)c;
+  }
+  cpa_pbuf[cpa_plen] = 0;
+}
+static void cpa_matrix(struct machine *oric, int i, int down)
+{
+  struct ay8912 *ay = &oric->ay;
+  if (down) ay->keystates[i>>3] |= (1<<(i&7));
+  else      ay->keystates[i>>3] &= ~(1<<(i&7));
+  if (ay->currkeyoffs == (Uint32)(i>>3)) {
+    if (ay->keystates[ay->currkeyoffs] & (ay->eregs[AY_PORT_A]^0xff))
+      oric->via.write_port_b(&oric->via, 0x08, 0x08);
+    else
+      oric->via.write_port_b(&oric->via, 0x08, 0x00);
+  }
+}
+/* Cadence : la touche reste 2 trames enfoncée (le clavier est lu à 50 Hz,
+   une lecture complète au moins), puis 1 trame relâchée ; SHIFT est posé une
+   trame avant la touche (une lecture à cheval sur deux trames ne doit pas
+   voir la touche sans SHIFT). 2 trames relâchées avant une touche identique
+   à la précédente (« ll », « 00 »), pour que le relâchement soit vu.
+   Environ 15 caractères par seconde ; après RETURN, une pause laisse le
+   logiciel traiter la ligne (plus longue sous BASIC, qui ne garde qu'une
+   touche d'avance). */
+static void cpa_paste_tick(struct machine *oric)
+{
+  static int phase = 0, key = -1, shift = 0, wait = 0, lastkey = -1, len = 0;
+  int i, c;
+  if (!cpa_pbuf || cpa_ppos >= cpa_plen) { lastkey = -1; return; }
+  if (wait > 0) { wait--; return; }
+  if (phase == 0) {
+    c = (unsigned char)cpa_pbuf[cpa_ppos];
+    key = -1; shift = 0;
+    for (i = 0; i < 64 && key < 0; i++) if (cpa_knorm[i] == c) key = i;
+    for (i = 0; i < 64 && key < 0; i++) if (cpa_kshift[i] == c) { key = i; shift = 1; }
+    if (key < 0) { cpa_ppos++; return; }
+    if (key == lastkey) { lastkey = -1; return; }   /* une trame relâchée de plus */
+    /* CP/A disquette (ROM masquée) : son verrouillage des majuscules ($021A = 1)
+       inverse la casse des lettres ; on l'inverse d'avance pour coller le texte tel quel */
+    if (!oric->romon && ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
+        && oric->cpu.read(&oric->cpu, 0x21A) == 1) shift = !shift;
+    len = shift ? 4 : 3;
+    if (shift) cpa_matrix(oric, 36, 1);
+    else       cpa_matrix(oric, key, 1);
+  }
+  if (phase == 1 && shift) cpa_matrix(oric, key, 1);
+  if (phase == len - 1) {
+    cpa_matrix(oric, key, 0);
+    if (shift) cpa_matrix(oric, 36, 0);
+  }
+  if (++phase >= len) {
+    phase = 0;
+    lastkey = key;
+    if (cpa_pbuf[cpa_ppos] == '\r') wait = oric->romon ? 25 : 8;
+    cpa_ppos++;
+  }
+}
+
+/* --- test hook (Claude): ORIC_KEYS / ORIC_KEYS_AT / ORIC_DUMP / ORIC_DUMP_AT --- */
+extern void ay_keypress(struct ay8912 *ay, SDL_COMPAT_KEY key, SDL_bool down);
+static void test_hook(struct machine *oric)
+{
+  static long fr = 0; static int idx = 0; static int phase = 0; static int dumped = 0;
+  static int shifted = 0;
+  const char *keys = getenv("ORIC_KEYS");
+  long kat = getenv("ORIC_KEYS_AT") ? atol(getenv("ORIC_KEYS_AT")) : 150;
+  long dat = getenv("ORIC_DUMP_AT") ? atol(getenv("ORIC_DUMP_AT")) : -1;
+  fr++;
+  if (getenv("ORIC_PASTE") && fr == (getenv("ORIC_PASTE_AT") ? atol(getenv("ORIC_PASTE_AT")) : kat)) cpa_paste(getenv("ORIC_PASTE"));   /* essai du collage */
+  static long pause_until = 0;
+  if (keys && fr >= kat && keys[idx] && fr >= pause_until) {
+    int c = (unsigned char)keys[idx];
+    if (c == '|') { pause_until = fr + 150; idx++; return; }   /* | = pause de 3 s */
+    if (c == 0x1c) { shifted |= 2; idx++; return; }   /* préfixe CTRL */
+    if (c == 6) { oric->cpu.nmi = SDL_TRUE; oric->cpu.nmicount = 2; idx++; pause_until = fr + 50; return; } /* bouton RESET */
+    SDL_COMPAT_KEY k; int needshift = 0;
+    if (c == '\n') k = SDLK_RETURN;
+    else if (c == '~') k = SDLK_BACKSPACE;   /* ~ = DEL */
+    else if (c == ' ') k = SDLK_SPACE;
+    else if (c >= 'A' && c <= 'Z') { k = c + 32; needshift = 1; }
+    else if (c == '$') { k = '4'; needshift = 1; }
+    else if (c == ':') { k = ';'; needshift = 1; }
+    else if (c == '*') { k = '8'; needshift = 1; }
+    else if (c == '"') { k = '\''; needshift = 1; }
+    else if (c == '+') { k = '='; needshift = 1; }
+    else if (c == '(') { k = '9'; needshift = 1; }
+    else if (c == ')') { k = '0'; needshift = 1; }
+    else if (c == '<') { k = ','; needshift = 1; }
+    else if (c == '>') { k = '.'; needshift = 1; }
+    else if (c == '?') { k = '/'; needshift = 1; }
+    else if (c == '#') { k = '3'; needshift = 1; }
+    else if (c == 1) k = SDLK_LEFT;
+    else if (c == 2) k = SDLK_RIGHT;
+    else if (c == 3) k = SDLK_UP;
+    else if (c == 4) k = SDLK_DOWN;
+    else if (c == 5) k = SDLK_LALT;   /* FUNCT */
+    else k = c;
+    if (phase == 0) { if (shifted & 2) ay_keypress(&oric->ay, SDLK_LCTRL, SDL_TRUE); if (needshift) { ay_keypress(&oric->ay, SDLK_LSHIFT, SDL_TRUE); shifted |= 1; } ay_keypress(&oric->ay, k, SDL_TRUE); }
+    if (phase == 4) { ay_keypress(&oric->ay, k, SDL_FALSE); if (shifted & 1) ay_keypress(&oric->ay, SDLK_LSHIFT, SDL_FALSE); if (shifted & 2) ay_keypress(&oric->ay, SDLK_LCTRL, SDL_FALSE); shifted = 0; }
+    if (++phase >= 8) { phase = 0; idx++; }
+  }
+  if (!dumped && dat >= 0 && fr >= dat && getenv("ORIC_DUMP")) {
+    FILE *f = fopen(getenv("ORIC_DUMP"), "wb"); int a;
+    if (f) { for (a = 0; a < 0x10000; a++) fputc((a>=0x300&&a<0x400)?0:oric->cpu.read(&oric->cpu, a), f); fclose(f); }
+    dumped = 1;
+  }
+}
+
