+/* CP/A : une touche du clavier dessiné reste enfoncée 3 trames au moins
+   (un toucher bref sur un écran tactile ne serait pas vu par une lecture du
+   clavier à 50 Hz), et les touches collantes (SHIFT, CTRL, FUNCT) sont
+   relâchées avec elle, pas à l'événement suivant (elles l'étaient avant
+   même que l'Oric ait vu la touche). */
+static int cpa_kframe = 0, cpa_kdown = -1;
+static SDL_COMPAT_KEY cpa_kkey;
+static SDL_bool cpa_kup = SDL_FALSE, cpa_kmods = SDL_FALSE;
+static struct machine *cpa_koric = NULL;
+static void cpa_key_release(void)
+{
+  ay_keypress(&cpa_koric->ay, cpa_kkey, SDL_FALSE);
+  if(cpa_kmods) release_keys = SDL_TRUE;
+  cpa_kdown = -1; cpa_kup = SDL_FALSE; cpa_kmods = SDL_FALSE;
+}
+void cpa_kbd_tick(void)   /* une fois par trame (main.c) */
+{
+  cpa_kframe++;
+  if(cpa_kdown >= 0 && cpa_kup && cpa_kframe - cpa_kdown >= 3)
+  {
+    cpa_key_release();
+    keyboard_event(NULL, cpa_koric, NULL);   /* relâche aussi les touches collantes */
+  }
+}
 
 
